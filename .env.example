# Copy to .env and fill in. .env is git-ignored — never commit real secrets.

# Honest contact that goes into the RA User-Agent header (be reachable).
RA_CONTACT=you@example.com

# Spotify app (developer.spotify.com). Redirect URI must match the app settings.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback

# Last.fm API key (last.fm/api/account/create — instant, free).
LASTFM_API_KEY=

# Telegram bot (via @BotFather) and the target group chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Bot username (without @) — used to build feedback deeplinks in calendar events.
TELEGRAM_BOT_USERNAME=

# Google Calendar OAuth client file (Desktop app). Path to the downloaded json.
GOOGLE_CREDENTIALS_FILE=credentials.json
