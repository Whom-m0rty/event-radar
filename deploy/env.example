# Copy to /etc/event-radar/env on the VM (root-owned, chmod 600).
# systemd reads this via EnvironmentFile=.

RA_CONTACT=you@example.com
LASTFM_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=MaksimEventBot
TELEGRAM_CHAT_ID=
# credentials.json + token.json are copied from your Mac into /opt/event-radar.
GOOGLE_CREDENTIALS_FILE=credentials.json
